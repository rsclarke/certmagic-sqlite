#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd -- "$repo_root"

SECONDS=0
echo "Installing mise if missing"
mise="$HOME/.local/bin/mise"
if [[ ! -x "$mise" ]]; then
  installer="$(mktemp)"
  trap 'rm -f -- "$installer"' EXIT
  curl --fail --silent --show-error --location https://mise.jdx.dev/install.sh -o "$installer"
  MISE_VERSION=v2026.11.3 sh "$installer"
fi
echo "mise ready after ${SECONDS}s"

echo "Installing pinned development tools"
"$mise" trust "$repo_root/mise.toml"
"$mise" install --locked
echo "Tools ready after ${SECONDS}s"

# Amp and supervised services start in non-interactive login shells.
profile_marker="# certmagic-sqlite mise environment: $repo_root"
if ! grep -Fqx -- "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

$profile_marker
if [[ -z "\${CERTMAGIC_SQLITE_MISE_ACTIVE:-}" ]]; then
  case "\$PWD" in
    "$repo_root"|"$repo_root"/*)
      eval "\$("$mise" env --shell bash)"
      export CERTMAGIC_SQLITE_MISE_ACTIVE=1
      ;;
  esac
fi
EOF
fi

echo "Downloading Go modules and warming the test/build cache"
"$mise" exec -- go mod download
"$mise" exec -- go test ./...
echo "Setup finished after ${SECONDS}s"
